#!/bin/sh
# Connects this computer to a klistra account, for Claude Code here to plan its projects: prints
# a link for the person to open, sign in and allow it, and the code that page shows. Then
# `klistra-login --wait` waits until they have (up to 100 seconds at a time).
# `klistra-login --setup` does both in one go, waiting as long as the link works (ten minutes):
# what the setup prompt runs, in the background, right after installing the plugin.
set -e
base="${KLISTRA_URL:-https://app.klistra.ai}"
base="${base%/}"
here=$(cd "$(dirname "$0")" && pwd)
token=$(KLISTRA_URL="$base" CLAUDE_CODE_MCP_SERVER_URL="$base/api/agent/mcp" sh "$here/klistra-token")

sha() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum
  else openssl dgst -sha256 -r
  fi
}
# what klistra says about this computer: an HTTP status, and the answer in "$answer"
me() {
  answer=$(curl -sS -m 20 -w '\n%{http_code}' -H "Authorization: Bearer $token" "$base/api/agent/me") || { echo "Could not reach klistra at $base." >&2; exit 1; }
  status=$(printf '%s' "$answer" | tail -n 1)
  answer=$(printf '%s' "$answer" | sed '$d')
}
field() { printf '%s' "$answer" | sed -n "s/.*\"$1\":\"\\([^\"]*\\)\".*/\\1/p" | head -n 1; }
connected() {
  team=$(printf '%s' "$answer" | sed -n 's/.*"team":{[^}]*"name":"\([^"]*\)".*/\1/p')
  echo "Connected: Claude Code here can plan in ${team:-the team} for $(field email)."
  if [ "$mode" = --setup ]; then echo "Restart Claude Code, or run /reload-plugins, for it to use klistra."; fi
}
# waits until the person has allowed this computer, looking every 3 seconds, $1 times at most
wait_for() {
  i=0
  while [ $i -lt "$1" ]; do
    me
    if [ "$status" = 200 ]; then connected; exit 0; fi
    if ! printf '%s' "$answer" | grep -q '"waiting":true'; then
      echo "Not connected: $(field error)"
      if [ "$mode" = --setup ]; then echo "Run the setup again for a new link."; else echo "Run klistra-login again for a new link."; fi
      exit 1
    fi
    i=$((i + 1))
    sleep 3
  done
}

mode="$1"
if [ "$mode" = --wait ]; then
  wait_for 34
  echo "Still waiting for the link to be opened and the computer allowed. Run klistra-login --wait again."
  exit 2
fi

me
if [ "$status" = 200 ]; then connected; exit 0; fi

computer=$(scutil --get ComputerName 2>/dev/null || hostname 2>/dev/null || echo "A computer")
hash=$(printf '%s' "$token" | sha | cut -c1-64)
name=$(printf '%s' "$computer" | sed 's/\\/\\\\/g; s/"/\\"/g')
answer=$(curl -sS -m 20 -X POST -H 'content-type: application/json' --data "{\"tokenHash\":\"$hash\",\"computer\":\"$name\",\"client\":\"claude-code\"}" "$base/api/agent/login") || { echo "Could not reach klistra at $base." >&2; exit 1; }
code=$(field code)
path=$(field path)
if [ -z "$code" ]; then
  echo "klistra did not give a code: $(field error)"
  exit 1
fi
echo "To connect $computer to klistra, open this link, sign in and allow it:"
echo
echo "  $base$path"
echo
echo "The page shows the code $code. The link works for ten minutes."
if [ "$mode" = --setup ]; then
  echo "Waiting for the computer to be allowed..."
  wait_for 200
  echo "The link ran out before the computer was allowed. Run the setup again for a new one."
  exit 2
fi
echo "Then run: klistra-login --wait"
