#!/bin/sh
# Runs klistra's runtime built for this computer. Claude Code on Windows starts klistra.exe
# beside this file directly; this is for macOS, Linux, and Git Bash on Windows.
dir=$(dirname "$0")
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) exec "$dir/klistra-darwin-arm64" "$@" ;;
  Darwin-x86_64) exec "$dir/klistra-darwin-x64" "$@" ;;
  Linux-x86_64) exec "$dir/klistra-linux-x64" "$@" ;;
  Linux-aarch64 | Linux-arm64) exec "$dir/klistra-linux-arm64" "$@" ;;
  MINGW*-x86_64 | MSYS*-x86_64 | CYGWIN*-x86_64) exec "$dir/klistra.exe" "$@" ;;
esac
echo "klistra: there's no runtime for $(uname -s) $(uname -m) in $dir" >&2
exit 1
